{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ydisks批量转存助手",
  "version": "1.0.0",
  "identifier": "com.ydisks.transfer-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5178",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ydisks批量转存助手",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/macos/Assets.car"
      },
      "infoPlist": "Info.macos.plist"
    },
    "category": "Productivity",
    "shortDescription": "Ydisks批量转存助手",
    "longDescription": "Ydisks批量转存助手：基于 Rust 与系统 WebView 的网盘批量转存与短链创建桌面应用。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
